# Painel do projeto Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# NUNCA exponha esta chave no cliente. Só é usada em app/api/invite/route.ts (servidor).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# URL pública do site, usada para montar o link de convite de administrador
NEXT_PUBLIC_SITE_URL=http://localhost:3000
